# Streamlit Community Cloud -> your app -> Settings -> Secrets. Paste the lines below (with your real key).
# NEVER put ANTHROPIC_API_KEY here for a public deploy.
NVIDIA_API_KEY = "nvapi-REPLACE_ME"
ENABLED_PROVIDERS = "nim"
AI_PROVIDER = "nim"
NIM_MODEL = "google/gemma-4-31b-it"
# Optional: required to press "Re-run all" (which spends credits). Pick your own.
RERUN_PASSCODE = "choose-a-long-passphrase"
