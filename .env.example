# ---- AI provider (model-independent: swap without code changes) ----
# lmstudio | anthropic | nim
AI_PROVIDER=lmstudio

# LM Studio (OpenAI-compatible local server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-12b-qat
# none = thinking off (fast). low/medium/high = thinking on (slower; may need a higher AI_TIMEOUT_SECONDS)
LMSTUDIO_REASONING_EFFORT=none

# Anthropic (only needed when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3

# ---- Data source ----
# fixture = canned test cases (demo). Future: alpaca | benzinga | edgar
NEWS_SOURCE=fixture
FIXTURE_PATH=data/test_cases.json

# ---- Storage ----
DB_PATH=data/scanner.db

# ---- Deterministic thresholds ----
MIN_MOVE_PCT_SMALL_CAP=10
MIN_MOVE_PCT_LARGE_CAP=4
MAX_NEWS_AGE_MINUTES=90
# Near-duplicate headline similarity (0-1) for cross-wire dedup
DEDUP_SIMILARITY=0.90
# Demo fixtures are not on the hardcoded watchlist; enforce=false flags but still processes
WATCHLIST_ENFORCE=false

# ---- NVIDIA NIM (hosted, OpenAI-compatible) ----
# Get a key at https://build.nvidia.com/settings/api-keys  (starts with nvapi-)
NVIDIA_API_KEY=
NIM_MODEL=google/gemma-4-31b-it
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- UI exposure ----
# Providers offered in the Streamlit UI. Public/hosted deploy: nim
ENABLED_PROVIDERS=anthropic,lmstudio,nim
# If set, "Re-run all" in the UI requires this passcode
RERUN_PASSCODE=
